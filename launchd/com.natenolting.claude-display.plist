<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.natenolting.claude-display</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/natenolting/claude-display/.venv/bin/python</string>
        <string>-m</string>
        <string>claude_display</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/natenolting/claude-display</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- exit is now non-blocking; keep the SIGKILL deadline short and ours -->
    <key>ExitTimeOut</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/natenolting/Library/Logs/claude-display.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/natenolting/Library/Logs/claude-display.log</string>
</dict>
</plist>
