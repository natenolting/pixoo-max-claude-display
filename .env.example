# Copy to .env and edit. Every key is optional except PIXOO_ADDRESS.
# A real environment variable of the same name overrides anything here.

# --- device (required) ----------------------------------------------------
# Your Pixoo's Bluetooth address. Find it in System Settings > Bluetooth, or
# with `blueutil --inquiry 10`. Colons or dashes both work.
# Do NOT pair the device — see docs/adr/0001-unpaired-direct-rfcomm.md.
PIXOO_ADDRESS=

# --- faces ----------------------------------------------------------------
# Seconds each face holds the panel. The state face always leads a cycle.
STATE_FACE_S=12
USAGE_FACE_S=8
TOKENS_FACE_S=8

# Set either to false to drop that face from the rotation entirely.
SHOW_USAGE_FACE=true
SHOW_TOKENS_FACE=true

# --- brightness -----------------------------------------------------------
DAY_BRIGHTNESS=80
NIGHT_BRIGHTNESS=15

# Night window, 24-hour local time. May wrap midnight (22 -> 7 is the default).
NIGHT_START_HOUR=22
NIGHT_END_HOUR=7

# Dim while the screen is locked, on the grounds that nobody is looking.
# Set false if you lock often but want the panel bright for passers-by.
DIM_WHEN_LOCKED=true

# --- behaviour ------------------------------------------------------------
# How long an unanswered WAITING session holds the panel before it demotes
# to idle. A blocked permission prompt never demotes.
WAITING_DEMOTION_MIN=30

# How often to re-run ccusage for the token face.
TOKEN_POLL_MIN=5

# Where hooks drop their events. Must match hooks/claude-display-hook.sh.
SPOOL_DIR=/tmp/claude-display/spool

# --- sessions -------------------------------------------------------------
# Track sessions managed by cmux. Set false to ignore them — useful only if
# you run a fleet of cmux sessions you consider background machinery.
TRACK_CMUX_SESSIONS=true

# How often to ask the API for rate-limit utilisation. The status line's
# cache is only a fallback: it refreshes when a session renders one, which
# can leave it badly stale.
USAGE_POLL_MIN=2
