{
  "//": "Generated by scripts/install.sh with real paths. Merge into the 'hooks' object of ~/.claude/settings.json (keep your existing PostToolUse entry). They feed the Pixoo display daemon from every Claude Code session.",
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/claude-display-hook.sh",
          "async": true
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/claude-display-hook.sh",
          "timeout": 3
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/claude-display-hook.sh",
          "async": true
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/claude-display-hook.sh",
          "async": true
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/claude-display-hook.sh",
          "async": true
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__REPO__/hooks/claude-display-hook.sh",
          "async": true
        }
      ]
    }
  ]
}